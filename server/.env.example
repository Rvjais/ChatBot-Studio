# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API server. Used in generated embed snippets and widget.js.
PUBLIC_API_URL=http://localhost:4000
# Dashboard URL (allowed by CORS for authenticated dashboard routes).
CLIENT_URL=http://localhost:5173
# Extra comma-separated origins allowed to call dashboard routes.
CORS_ORIGINS=
# Set to the number of proxies in front of the app (e.g. 1 behind Nginx/Render/Heroku).
TRUST_PROXY=0
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────
# Required in production. In development, leave empty to use an embedded MongoDB
# persisted under server/.data/db (downloaded automatically on first run).
MONGODB_URI=

# ─── Secrets (REQUIRED in production) ────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# 32-byte key, base64 or hex. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored AI provider API keys unreadable.
ENCRYPTION_KEY=

# ─── Platform limits ─────────────────────────────────────────────────────
MAX_CHATBOTS_PER_USER=50
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
MAX_PRODUCTS_PER_CHATBOT=50000
MAX_PRODUCT_IMPORT_MB=15
UPLOAD_DIR=./uploads

# ─── Widget limits ───────────────────────────────────────────────────────
WIDGET_MAX_MESSAGE_CHARS=2000
WIDGET_MAX_PRODUCTS=100
WIDGET_MAX_PRODUCTS_BYTES=65536
WIDGET_MAX_MESSAGES_PER_CONVERSATION=200
# Allow the platform's own /embed-test preview page even when domain restrictions are on.
ALLOW_PLATFORM_PREVIEW_ORIGIN=true

# ─── Rate limits (requests per window) ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_WIDGET_CHAT_PER_MIN=20
RATE_LIMIT_WIDGET_CONFIG_PER_MIN=120
RATE_LIMIT_PROVIDER_TEST_PER_MIN=10

# ─── AI requests ─────────────────────────────────────────────────────────
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Optional JSON file that extends/overrides the built-in model catalog (see docs/MODELS.md).
MODEL_CATALOG_PATH=

# ─── Vector search ───────────────────────────────────────────────────────
# "memory": cosine similarity computed in the app over chatbot-filtered chunks (works anywhere).
# "atlas": MongoDB Atlas Vector Search ($vectorSearch) — requires an Atlas vector index.
VECTOR_STORE=memory
ATLAS_VECTOR_INDEX=knowledge_chunk_vector_index

# ─── Background jobs ─────────────────────────────────────────────────────
# true: the API process also processes uploaded documents.
# false: run a separate worker with `npm run worker` (see server/.env.worker.example).
RUN_WORKER_IN_PROCESS=true
JOB_POLL_INTERVAL_MS=1500
JOB_CONCURRENCY=2

# ─── Static hosting ──────────────────────────────────────────────────────
# Serve the built dashboard (client/dist) from this server (single-origin deployment).
SERVE_CLIENT=false
