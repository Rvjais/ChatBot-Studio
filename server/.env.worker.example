# Environment for a dedicated background worker process (`npm run worker`).
# The worker must share the same MongoDB, ENCRYPTION_KEY and UPLOAD_DIR as the API server.
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/chatbot_builder
ENCRYPTION_KEY=
UPLOAD_DIR=./uploads
JOB_POLL_INTERVAL_MS=1500
JOB_CONCURRENCY=2
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
VECTOR_STORE=memory
LOG_LEVEL=info
# The worker never serves HTTP; JWT_SECRET is not used but may be set to satisfy shared config.
JWT_SECRET=
