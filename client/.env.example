# Base URL of the API server. Leave empty to use the same origin:
#  - development: requests go through the Vite proxy (see vite.config.ts)
#  - production: the API serves the built dashboard (SERVE_CLIENT=true)
VITE_API_URL=

# Development only: where the Vite dev server proxies /api, /widget.js and /embed-test.
VITE_PROXY_TARGET=http://localhost:4000
